    <string>Scopino usa Apple Events per rilevare le app rimosse da /Applications.</string>

    <!-- Supporto versioni macOS -->
    <key>LSMinimumSystemVersion</key>
    <string>26.0</string>

    <!-- Nessuna finestra principale — menu bar only -->
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
    
